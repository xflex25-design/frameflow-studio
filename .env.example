# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq API text completions.
GROQ_API_KEY="MY_GROQ_API_KEY"

# FAL_KEY: Required for fal.ai video generation.
FAL_KEY="fal_sk_..."

# HF_TOKEN: Required for Hugging Face inference API and video generation.
HF_TOKEN="hf_..."

# VIDEO_PROVIDER: "fal" or "huggingface"
VIDEO_PROVIDER="huggingface"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
